# PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_MAX_RETRIES=10
DATABASE_RETRY_DELAY_SECONDS=3
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Upload Configuration
MAX_UPLOAD_SIZE_MB=10

# Retrieval and embeddings
EMBEDDING_MODEL_NAME=paraphrase-MiniLM-L3-v2
EMBEDDING_BATCH_SIZE=16
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Google Cloud Storage Resume Storage
# Cloud Run uses Application Default Credentials from its service account.
GCS_BUCKET_NAME=your-resume-bucket-name
GCS_KEY_PREFIX=resumes

# Google Cloud Pub/Sub (required only when async publishing is enabled)
GCP_PROJECT_ID=your-gcp-project-id
PUBSUB_RESUME_PROCESSING_TOPIC=resume-processing

# Frontend
# Set this in frontend/.env.local or the Vercel project environment.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application
APP_NAME=AI Resume Intelligence
APP_VERSION=1.0.0
ENVIRONMENT=development
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Authentication
# Generate a strong random value for each deployed environment.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password Recovery
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUEST_LIMIT=3
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=15

# Email delivery
# Use console only for local development. Production must use smtp.
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
