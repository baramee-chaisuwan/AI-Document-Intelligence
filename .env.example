# PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# Google Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Upload Configuration
MAX_UPLOAD_SIZE_MB=10

# Google Cloud Storage Resume Storage
# Cloud Run uses Application Default Credentials from its service account.
GCS_BUCKET_NAME=your-resume-bucket-name
GCS_KEY_PREFIX=resumes

# Frontend
FRONTEND_URL=http://localhost:3000

# Application
APP_NAME=AI Resume Intelligence
APP_VERSION=1.0.0

# Authentication
# Generate a strong random value for each deployed environment.
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Password Recovery
PASSWORD_RESET_OTP_EXPIRE_MINUTES=10
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=10
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_REQUEST_LIMIT=3
PASSWORD_RESET_REQUEST_WINDOW_MINUTES=15

# Email delivery
# Use console only for local development. Production must use smtp.
EMAIL_BACKEND=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
